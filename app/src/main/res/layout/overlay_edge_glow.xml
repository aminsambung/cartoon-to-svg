<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Efek cahaya tepi layar -->
    <com.example.edgeglow.EdgeGlowView
        android:id="@+id/edgeGlowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- (Opsional) Kartu notifikasi kecil di tengah atas layar -->
    <LinearLayout
        android:id="@+id/notificationCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_notification_card"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/sym_def_app_icon" /> <!-- BAGIAN INI DIGANTI -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesan baru masuk"
                android:textSize="12sp"
                android:textColor="#DDDDDD"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
